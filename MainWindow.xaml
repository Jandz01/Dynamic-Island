<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dynamic Island"
        Height="480" Width="980"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseUp="Window_PreviewMouseUp">

    <Window.Resources>
        <!-- Standard Action Chip -->
        <Style x:Key="ActionChipStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1F2C"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D3748"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AiChipStyle" TargetType="Button" BasedOn="{StaticResource ActionChipStyle}">
            <Setter Property="Background" Value="#2B1A4A"/>
            <Setter Property="BorderBrush" Value="#8B5CF6"/>
            <Setter Property="Foreground" Value="#E9D5FF"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E11D48"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircleIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MediaControlBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#090B10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Planet Capsule Style -->
        <Style x:Key="OrbitalPlanetStyle" TargetType="Border">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform x:Name="ScaleT" ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container -->
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        
        <!-- FLUID CANVAS FOR WATER DROPLET & ORBITAL PHYSICS -->
        <Canvas x:Name="FluidCanvas" Width="980" Height="480" IsHitTestVisible="False">
            
            <!-- REAL TEARDROP FALLING DROPLET (Point at top, bulbous at bottom) -->
            <Path x:Name="FallingDroplet" 
                  Data="M 16,0 C 16,0 32,22 32,36 C 32,46 25,54 16,54 C 7,54 0,46 0,36 C 0,22 16,0 16,0 Z" 
                  Fill="#07090E" Stroke="#EA580C" StrokeThickness="2" 
                  Canvas.Left="474" Canvas.Top="0" Opacity="0"
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <ScaleTransform x:Name="FallingDropletScale" ScaleX="1" ScaleY="1"/>
                </Path.RenderTransform>
                <Path.Effect>
                    <DropShadowEffect x:Name="FallingDropletGlow" Color="#EA580C" BlurRadius="26" ShadowDepth="0" Opacity="1.0"/>
                </Path.Effect>
            </Path>

            <!-- REAL TEARDROP REVERSE DROPLET (Flowing upwards: bulbous at top, tail at bottom) -->
            <Path x:Name="ReverseDroplet" 
                  Data="M 16,54 C 16,54 32,32 32,18 C 32,8 25,0 16,0 C 7,0 0,8 0,18 C 0,32 16,54 16,54 Z" 
                  Fill="#07090E" Stroke="#38BDF8" StrokeThickness="2" 
                  Canvas.Left="474" Canvas.Top="140" Opacity="0"
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <ScaleTransform x:Name="ReverseDropletScale" ScaleX="1" ScaleY="1"/>
                </Path.RenderTransform>
                <Path.Effect>
                    <DropShadowEffect x:Name="ReverseDropletGlow" Color="#38BDF8" BlurRadius="26" ShadowDepth="0" Opacity="1.0"/>
                </Path.Effect>
            </Path>
        </Canvas>

        <!-- HIGH-FIDELITY ORBITAL PLANETS VIEW (Zero Bounding Box, Free Floating, Correct Position) -->
        <Grid x:Name="ViewOrbital" Width="680" Height="300" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
            <Canvas x:Name="OrbitCanvas" Width="680" Height="300" HorizontalAlignment="Center" VerticalAlignment="Top">
                
                <!-- Laser Beam from Black Hole to Hovered Planet -->
                <Line x:Name="ConnectingLine" 
                      X1="340" Y1="150" X2="340" Y2="150"
                      Stroke="#F97316" StrokeThickness="1.6" StrokeDashArray="3 3"
                      Opacity="0">
                    <Line.Effect>
                        <DropShadowEffect x:Name="LineGlow" Color="#F97316" BlurRadius="14" ShadowDepth="0" Opacity="0.95"/>
                    </Line.Effect>
                </Line>

                <!-- Elliptical Orbital Track -->
                <Ellipse Canvas.Left="130" Canvas.Top="40" Width="420" Height="220" 
                         Stroke="#1E293B" StrokeDashArray="4 4" StrokeThickness="1.2" Opacity="0.5"/>

                <!-- PURE BLACK HOLE (Fiery Amber Accretion Disk, Zero Text) -->
                <Border x:Name="BlackHoleCore" Canvas.Left="295" Canvas.Top="105" Width="90" Height="90" CornerRadius="45" 
                        Background="#020202" BorderThickness="2.5" Cursor="Hand" 
                        ToolTip="Hố đen trung tâm - Nhấp để thu gọn về thanh đảo"
                        PreviewMouseLeftButtonDown="CoreHub_Click"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="BlackHoleScale" ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F97316" Offset="0"/>
                            <GradientStop Color="#FBBF24" Offset="0.5"/>
                            <GradientStop Color="#EA580C" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect Color="#EA580C" BlurRadius="38" ShadowDepth="0" Opacity="1.0"/>
                    </Border.Effect>
                    <Ellipse Width="76" Height="76" Stroke="#F59E0B" StrokeThickness="0.8" Opacity="0.3"/>
                </Border>

                <!-- Satellite 1: Music (Luminous Amber) -->
                <Border x:Name="OrbMusic" Style="{StaticResource OrbitalPlanetStyle}" 
                        Canvas.Left="314" Canvas.Top="124" Background="#3D1E05" BorderBrush="#FBBF24" BorderThickness="1.8"
                        ToolTip="Music Player" MouseLeftButtonDown="OrbMusic_Click"
                        MouseEnter="Planet_MouseEnter" MouseLeave="Planet_MouseLeave">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="TransMusic"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Effect><DropShadowEffect Color="#F59E0B" BlurRadius="20" ShadowDepth="0" Opacity="0.9" RenderingBias="Performance"/></Border.Effect>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🎵" FontSize="20" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblMusic" Text="Music" Foreground="#FEF3C7" FontSize="12.5" FontWeight="Bold" 
                                   Margin="8,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Satellite 2: Notification & Messages (Luminous Cyan/Blue) -->
                <Border x:Name="OrbNotify" Style="{StaticResource OrbitalPlanetStyle}" 
                        Canvas.Left="314" Canvas.Top="124" Background="#0C2540" BorderBrush="#38BDF8" BorderThickness="1.8"
                        ToolTip="Thông báo &amp; Tin nhắn (Zalo, Messenger, Telegram)" MouseLeftButtonDown="OrbNotify_Click"
                        MouseEnter="Planet_MouseEnter" MouseLeave="Planet_MouseLeave">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="TransNotify"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Effect><DropShadowEffect Color="#38BDF8" BlurRadius="20" ShadowDepth="0" Opacity="0.9" RenderingBias="Performance"/></Border.Effect>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="💬" FontSize="20" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblNotify" Text="Tin nhắn" Foreground="#E0F2FE" FontSize="12.5" FontWeight="Bold" 
                                   Margin="8,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Satellite 3: Lock Screen (Luminous Rose/Red) -->
                <Border x:Name="OrbLockScreen" Style="{StaticResource OrbitalPlanetStyle}" 
                        Canvas.Left="314" Canvas.Top="124" Background="#4C0A1C" BorderBrush="#FB7185" BorderThickness="1.8"
                        ToolTip="Khóa màn hình máy tính (Lock Screen)" MouseLeftButtonDown="OrbLockScreen_Click"
                        MouseEnter="Planet_MouseEnter" MouseLeave="Planet_MouseLeave">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="TransLockScreen"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Effect><DropShadowEffect Color="#F43F5E" BlurRadius="20" ShadowDepth="0" Opacity="0.9" RenderingBias="Performance"/></Border.Effect>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🔒" FontSize="20" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblLockScreen" Text="Khóa máy" Foreground="#FFF1F2" FontSize="12.5" FontWeight="Bold" 
                                   Margin="8,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Satellite 4: Dropzone (Luminous Emerald) -->
                <Border x:Name="OrbDrop" Style="{StaticResource OrbitalPlanetStyle}" 
                        Canvas.Left="314" Canvas.Top="124" Background="#063E2D" BorderBrush="#34D399" BorderThickness="1.8"
                        ToolTip="NotebookLM Dropzone Files" MouseLeftButtonDown="OrbDrop_Click"
                        MouseEnter="Planet_MouseEnter" MouseLeave="Planet_MouseLeave">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="TransDrop"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Effect><DropShadowEffect Color="#10B981" BlurRadius="20" ShadowDepth="0" Opacity="0.9" RenderingBias="Performance"/></Border.Effect>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📁" FontSize="20" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblDrop" Text="Dropzone" Foreground="#ECFDF5" FontSize="12.5" FontWeight="Bold" 
                                   Margin="8,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Satellite 5: Camera Laptop (Luminous Emerald/Cyan) -->
                <Border x:Name="OrbCamera" Style="{StaticResource OrbitalPlanetStyle}" 
                        Canvas.Left="314" Canvas.Top="124" Background="#063E2D" BorderBrush="#10B981" BorderThickness="1.8"
                        ToolTip="Bật Camera Laptop" MouseLeftButtonDown="OrbCamera_Click"
                        MouseEnter="Planet_MouseEnter" MouseLeave="Planet_MouseLeave">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="TransCamera"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Effect><DropShadowEffect Color="#10B981" BlurRadius="20" ShadowDepth="0" Opacity="0.9" RenderingBias="Performance"/></Border.Effect>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📷" FontSize="20" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblCamera" Text="Camera" Foreground="#ECFDF5" FontSize="12.5" FontWeight="Bold" 
                                   Margin="8,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Satellite 6: Pomodoro Focus (Luminous Gold) -->
                <Border x:Name="OrbPomodoro" Style="{StaticResource OrbitalPlanetStyle}" 
                        Canvas.Left="314" Canvas.Top="124" Background="#423403" BorderBrush="#FACC15" BorderThickness="1.8"
                        ToolTip="Pomodoro Timer" MouseLeftButtonDown="OrbPomodoro_Click"
                        MouseEnter="Planet_MouseEnter" MouseLeave="Planet_MouseLeave">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="TransPomodoro"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Effect><DropShadowEffect Color="#EAB308" BlurRadius="20" ShadowDepth="0" Opacity="0.9" RenderingBias="Performance"/></Border.Effect>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⏱️" FontSize="20" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblPomodoro" Text="Pomodoro" Foreground="#FEFCE8" FontSize="12.5" FontWeight="Bold" 
                                   Margin="8,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

            </Canvas>
        </Grid>

        <!-- DYNAMIC NOTCH WITH INWARD EAR BRACKETS (Seamless Top Bezel Anchor) -->
        <Grid x:Name="NotchRoot" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0"
              Background="Transparent"
              PreviewMouseLeftButtonDown="NotchRoot_PreviewMouseLeftButtonDown">
            
            <!-- Authentic Notch Outline with Flared Top Ears -->
            <Path x:Name="NotchPath" 
                  Fill="#0B0D14" 
                  StrokeThickness="1.4">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#38BDF8" Offset="0.0"/>
                        <GradientStop Color="#FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#C084FC" Offset="1.0"/>
                    </LinearGradientBrush>
                </Path.Stroke>
                <Path.Effect>
                    <DropShadowEffect x:Name="CardGlow" Color="#38BDF8" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                </Path.Effect>
            </Path>

            <!-- Card Content Container -->
            <Border x:Name="IslandCard" 
                    Width="540" Height="38"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Background="Transparent"
                    CornerRadius="0,0,20,20"
                    ClipToBounds="True">
                
                <Grid>
                    <!-- 0. MINI SIZE VIEW: Ultra-compact, only spinning vinyl disc, does not block browser tabs -->
                    <Grid x:Name="ViewMini" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Cursor="Hand"
                          ToolTip="Đang thu nhỏ (Minisize) • Giữ :: để kéo • Nhấp đĩa để phóng to">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mini Drag Handle :: -->
                        <Border Grid.Column="0" Tag="DragGrip" Background="#1E293B" CornerRadius="4" Padding="3,1" Margin="0,0,5,0"
                                Cursor="SizeAll" ToolTip="Giữ chuột vào đây để kéo di chuyển Dynamic Island (Click đúp để về giữa)"
                                PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="DragHandle_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="DragHandle_PreviewMouseLeftButtonUp">
                            <TextBlock Text="::" FontSize="11" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Spinning Mini Vinyl Record -->
                        <Border Grid.Column="1" Width="22" Height="22" CornerRadius="11" 
                                Background="#0A0714" BorderBrush="#A855F7" BorderThickness="1.2"
                                RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                            <Border.RenderTransform>
                                <RotateTransform x:Name="MiniVinylRotate" Angle="0"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="#A855F7" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                            </Border.Effect>
                            <Grid>
                                <Ellipse Width="18" Height="18" Stroke="#2D2245" StrokeThickness="0.6"/>
                                <Ellipse Width="14" Height="14" Stroke="#2D2245" StrokeThickness="0.6"/>
                                <Ellipse Width="6" Height="6" Fill="#0A0714" Stroke="#C084FC" StrokeThickness="0.8"/>
                                <TextBlock x:Name="TxtMiniVinylCenterIcon" Text="🎵" FontSize="8" Foreground="#F8FAFC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Mini indicator hint -->
                        <TextBlock Grid.Column="2" Text=" ▾" FontSize="10" Foreground="#A855F7" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </Grid>

                    <!-- 1. COMPACT NOTCH BAR VIEW: Minimalist, Authentic -->
                    <Grid x:Name="ViewCompact" Visibility="Visible" VerticalAlignment="Center" Margin="18,0" Cursor="Hand"
                          ToolTip="Kéo dãn xuống để bung Vệ tinh Hành tinh (Orbital Mode)">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Drag Grip Handle & Real Time -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Drag Handle :: để kéo di chuyển -->
                            <Border x:Name="DragGripHandle" Tag="DragGrip" Background="#1E293B" CornerRadius="5" Padding="5,1" Margin="0,0,7,0"
                                    Cursor="SizeAll" ToolTip="Giữ chuột vào đây để kéo di chuyển Dynamic Island (Click đúp để về giữa)"
                                    PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="DragHandle_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="DragHandle_PreviewMouseLeftButtonUp">
                                <TextBlock Text="::" FontSize="13" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="🕒" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtClock" Text="04:29:41 Thứ Ba, 15/09" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Center: Hardware Metrics (Battery, RAM, ROM, Live Mini Vinyl Disc, Screen Record Dot) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Battery -->
                            <Border Background="#141923" CornerRadius="9" Padding="7,2" Margin="3,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtBatteryIcon" Text="⚡" FontSize="11" Foreground="#38BDF8" Margin="0,0,3,0"/>
                                    <TextBlock x:Name="TxtBattery" Text="100%" Foreground="#E2E8F0" FontSize="11" FontWeight="Medium"/>
                                </StackPanel>
                            </Border>

                            <!-- RAM -->
                            <Border Background="#141923" CornerRadius="9" Padding="7,2" Margin="3,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💬" FontSize="11" Margin="0,0,3,0"/>
                                    <TextBlock x:Name="TxtRam" Text="52%" Foreground="#CBD5E1" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <!-- ROM (Disk C) -->
                            <Border Background="#141923" CornerRadius="9" Padding="7,2" Margin="3,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾" FontSize="11" Margin="0,0,3,0"/>
                                    <TextBlock x:Name="TxtRom" Text="45%" Foreground="#CBD5E1" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <!-- Mini Spinning Vinyl Disc / Music Ticker -->
                            <Border x:Name="PillMediaMini" Background="#1B152B" BorderBrush="#A855F7" BorderThickness="0.8" 
                                    CornerRadius="9" Padding="6,2" Margin="3,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtMediaWave" Text="🎵" FontSize="11" Foreground="#C084FC" Margin="0,0,3,0"/>
                                    <TextBlock x:Name="TxtMediaTitleCompact" Text="Music" Foreground="#E9D5FF" FontSize="11" MaxWidth="80" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Screen Recording / Capture Button (Pulsing Red Dot) -->
                            <Button x:Name="BtnRecordScreen" Style="{StaticResource CircleIconBtn}" Width="20" Height="20" Margin="5,0,0,0"
                                    ToolTip="Bật công cụ quay / chụp màn hình (Snipping Tool &amp; Game Bar)"
                                    Click="BtnRecordScreen_Click">
                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Ellipse x:Name="DotRecordPulse" Width="13" Height="13" Fill="#EF4444" Opacity="0.4">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#EF4444" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse Width="7" Height="7" Fill="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- Right: Center Reset, Minisize & Exit App (Movement arrows removed, drag :: handle used instead) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Center Reset -->
                            <Button Style="{StaticResource CircleIconBtn}" Width="20" Height="20" ToolTip="Về Chính Giữa màn hình (hoặc phím Home)" Click="BtnResetCenter_Click" Margin="0,0,5,0">
                                <TextBlock Text="⦿" FontSize="10" Foreground="#38BDF8"/>
                            </Button>
                            
                            <!-- Minisize -->
                            <Button x:Name="BtnMiniSize" Style="{StaticResource CircleIconBtn}" Width="20" Height="20"
                                    ToolTip="Thu nhỏ siêu gọn (tránh cấn tab trình duyệt)" Click="BtnMiniSize_Click" Margin="0,0,4,0">
                                <TextBlock Text="➖" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            
                            <!-- Exit / Shutdown App -->
                            <Button x:Name="BtnExitApp" Style="{StaticResource CircleIconBtn}" Width="20" Height="20"
                                    ToolTip="Tắt Dynamic Island (Thoát hẳn ứng dụng)" Click="BtnExitApp_Click">
                                <TextBlock Text="✕" FontSize="11" Foreground="#EF4444" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 3. MUSIC TASK (Large Zone: 640x135, Big Vinyl Disc with Full Album Art, Seekable Timeline) -->
                    <Grid x:Name="ViewMusic" Visibility="Collapsed" Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Drag Grip Handle & Big Rotating Vinyl Record (80px) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Border Tag="DragGrip" Background="#1E293B" CornerRadius="5" Padding="5,2" Margin="0,0,10,0"
                                    Cursor="SizeAll" ToolTip="Giữ chuột vào đây để kéo di chuyển Dynamic Island (Click đúp để về giữa)"
                                    PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="DragHandle_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="DragHandle_PreviewMouseLeftButtonUp"
                                    VerticalAlignment="Center">
                                <TextBlock Text="::" FontSize="13" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>

                            <Border Width="80" Height="80" CornerRadius="40" 
                                    Background="#0A0714" BorderThickness="2" BorderBrush="#C084FC" 
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <RotateTransform x:Name="VinylRotate" Angle="0"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect Color="#C084FC" BlurRadius="22" ShadowDepth="0" Opacity="0.85"/>
                                </Border.Effect>
                                <Grid>
                                    <Ellipse Width="72" Height="72" Stroke="#2D2245" StrokeThickness="1"/>
                                    <Ellipse Width="62" Height="62" Stroke="#2D2245" StrokeThickness="1"/>
                                    <Ellipse x:Name="AlbumCoverEllipse" Width="58" Height="58">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="AlbumCoverBrush" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Width="10" Height="10" Fill="#0A0714" Stroke="#A855F7" StrokeThickness="1"/>
                                    <TextBlock x:Name="TxtVinylCenterIcon" Text="🎵" FontSize="18" Foreground="#F8FAFC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Song Info & Seekable Slider -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtMusicTitle" Text="Đang chờ bài hát trên Spotify/Windows..." Foreground="#F8FAFC" FontSize="14.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtMusicArtist" Text="Spotify • YouTube • Apple Music" Foreground="#A78BFA" FontSize="11.5" Margin="0,3,0,0"/>
                            
                            <Grid Margin="0,10,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtCurrentTime" Grid.Column="0" Text="00:00" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider x:Name="SliderMusicTime" Grid.Column="1" Minimum="0" Maximum="100" Value="0" 
                                        IsMoveToPointEnabled="True" VerticalAlignment="Center" Cursor="Hand"
                                        PreviewMouseDown="SliderMusicTime_PreviewMouseDown"
                                        PreviewMouseUp="SliderMusicTime_PreviewMouseUp"/>
                                <TextBlock x:Name="TxtTotalTime" Grid.Column="2" Text="00:00" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource MediaControlBtn}" ToolTip="Bài trước" Click="BtnMediaPrev_Click" Margin="0,0,6,0">
                                <TextBlock Text="⏮️" FontSize="14"/>
                            </Button>
                            <Button x:Name="BtnPlayPause" Style="{StaticResource MediaControlBtn}" ToolTip="Phát / Dừng" Click="BtnMediaPlayPause_Click" Margin="0,0,6,0">
                                <TextBlock x:Name="TxtPlayPauseIcon" Text="▶️" FontSize="15"/>
                            </Button>
                            <Button Style="{StaticResource MediaControlBtn}" ToolTip="Bài tiếp" Click="BtnMediaNext_Click" Margin="0,0,8,0">
                                <TextBlock Text="⏭️" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource CircleIconBtn}" ToolTip="Thu nhỏ siêu gọn (tránh cấn tab)" Click="BtnMiniSize_Click" Margin="0,0,6,0">
                                <TextBlock Text="➖" FontSize="11"/>
                            </Button>
                            <Button Style="{StaticResource CircleIconBtn}" ToolTip="Đóng" Click="BtnCloseToCompact_Click">
                                <TextBlock Text="✕" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 4. POMODORO TASK (Size: 480x100) -->
                    <Grid x:Name="ViewPomodoro" Visibility="Collapsed" Margin="16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Drag Grip Handle & Pomodoro Digits -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Border Tag="DragGrip" Background="#1E293B" CornerRadius="5" Padding="5,2" Margin="0,0,10,0"
                                    Cursor="SizeAll" ToolTip="Giữ chuột vào đây để kéo di chuyển Dynamic Island (Click đúp để về giữa)"
                                    PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="DragHandle_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="DragHandle_PreviewMouseLeftButtonUp"
                                    VerticalAlignment="Center">
                                <TextBlock Text="::" FontSize="13" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>

                            <Border Background="#291F03" BorderBrush="#FACC15" BorderThickness="1.5" CornerRadius="14" Padding="14,6">
                                <Border.Effect>
                                    <DropShadowEffect Color="#EAB308" BlurRadius="16" ShadowDepth="0" Opacity="0.8"/>
                                </Border.Effect>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtPomodoroDigits" Text="25:00" Foreground="#FEF08A" FontSize="26" FontWeight="Bold" FontFamily="Consolas"/>
                                    <TextBlock x:Name="TxtPomodoroStatus" Text="FOCUS" Foreground="#CA8A04" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button x:Name="BtnPomo25" Style="{StaticResource ActionChipStyle}" Content="25m Focus" Margin="0,0,5,0" Click="BtnPomoPreset_Click"/>
                                <Button x:Name="BtnPomo5" Style="{StaticResource ActionChipStyle}" Content="5m Break" Margin="0,0,5,0" Click="BtnPomoPreset_Click"/>
                                <Button x:Name="BtnPomo15" Style="{StaticResource ActionChipStyle}" Content="15m Rest" Click="BtnPomoPreset_Click"/>
                            </StackPanel>
                            <ProgressBar x:Name="PomodoroBar" Height="4" Maximum="100" Value="100" Background="#1E293B" Foreground="#EAB308"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Button x:Name="BtnPomoStartPause" Style="{StaticResource ActionChipStyle}" Content="▶ Start" Background="#3B2E05" BorderBrush="#EAB308" Foreground="#FEF08A" Margin="0,0,6,0" Click="BtnPomoStartPause_Click"/>
                            <Button Style="{StaticResource ActionChipStyle}" Content="🔄" Margin="0,0,8,0" Click="BtnPomoReset_Click"/>
                            <Button Style="{StaticResource CircleIconBtn}" Click="BtnCloseToCompact_Click">
                                <TextBlock Text="✕" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 5. CAMERA TASK (Size: 560x110) -->
                    <Grid x:Name="ViewCamera" Visibility="Collapsed" Margin="16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Drag Grip Handle & Camera Icon -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Border Tag="DragGrip" Background="#1E293B" CornerRadius="5" Padding="5,2" Margin="0,0,10,0"
                                    Cursor="SizeAll" ToolTip="Giữ chuột vào đây để kéo di chuyển Dynamic Island (Click đúp để về giữa)"
                                    PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="DragHandle_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="DragHandle_PreviewMouseLeftButtonUp"
                                    VerticalAlignment="Center">
                                <TextBlock Text="::" FontSize="13" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>

                            <Border Width="50" Height="50" CornerRadius="16" Background="#063E2D" BorderBrush="#10B981" BorderThickness="1.5">
                                <Border.Effect>
                                    <DropShadowEffect Color="#10B981" BlurRadius="18" ShadowDepth="0" Opacity="0.8"/>
                                </Border.Effect>
                                <TextBlock Text="📷" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Camera Laptop &amp; Webcam" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" Margin="0,0,8,0"/>
                                <Border x:Name="BorderCameraStatus" Background="#1E293B" BorderBrush="#475569" BorderThickness="0.8" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCameraStatus" Text="⚪ Đang tắt" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Bật / tắt nhanh camera laptop khi họp online hoặc kiểm tra webcam" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,6"/>
                            
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnToggleCamera" Style="{StaticResource ActionChipStyle}" Background="#059669" BorderBrush="#34D399" Foreground="#FFFFFF" FontWeight="Bold"
                                        Content="📷 Bật Camera" Margin="0,0,6,0" Click="BtnToggleCamera_Click"/>
                                <Button Style="{StaticResource ActionChipStyle}" Content="⚙ Quyền riêng tư" Margin="0,0,6,0" Click="BtnCameraSettings_Click"/>
                                <Button Style="{StaticResource ActionChipStyle}" Content="📸 Chụp màn hình" Click="BtnRecordScreen_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource CircleIconBtn}" VerticalAlignment="Top" Click="BtnCloseToCompact_Click">
                            <TextBlock Text="✕" FontSize="12"/>
                        </Button>
                    </Grid>

                    <!-- 6. NOTIFICATION TASK (Size: 620x155, Message Popup, Filter Tabs & Quick Reply) -->
                    <Grid x:Name="ViewNotification" Visibility="Collapsed" Margin="16,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header: App Badge, Sender Name, Filter Tabs, Delete & Navigation -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- App Icon & Badge with Drag Handle -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Border Tag="DragGrip" Background="#1E293B" CornerRadius="5" Padding="5,2" Margin="0,0,8,0"
                                        Cursor="SizeAll" ToolTip="Giữ chuột vào đây để kéo di chuyển Dynamic Island (Click đúp để về giữa)"
                                        PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="DragHandle_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="DragHandle_PreviewMouseLeftButtonUp"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="::" FontSize="13" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Border>

                                <Border x:Name="BadgeAppIcon" Width="28" Height="28" CornerRadius="14" 
                                        Background="#0068FF" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="BadgeAppGlow" Color="#0068FF" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>
                                    </Border.Effect>
                                    <TextBlock x:Name="TxtAppIcon" Text="💬" FontSize="14" Foreground="White" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtNotifySender" Text="Trần Hải Đăng" Foreground="#F8FAFC" FontSize="12.5" FontWeight="Bold" MaxWidth="110" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                        <Border x:Name="BorderAppTag" Background="#0C2540" BorderBrush="#0284C7" BorderThickness="0.8" CornerRadius="8" Padding="5,1" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtAppTag" Text="Zalo" Foreground="#38BDF8" FontSize="9.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtNotifyTime" Text="Vừa xong" Foreground="#94A3B8" FontSize="10" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Filter Tabs: Tất cả | Zalo | Facebook -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button x:Name="BtnFilterAll" Style="{StaticResource ActionChipStyle}" Content="Tất cả (0)" Padding="6,2" Margin="0,0,3,0" Click="BtnFilterAll_Click"/>
                                <Button x:Name="BtnFilterZalo" Style="{StaticResource ActionChipStyle}" Content="💬 Zalo (0)" Padding="6,2" Margin="0,0,3,0" Click="BtnFilterZalo_Click"/>
                                <Button x:Name="BtnFilterFacebook" Style="{StaticResource ActionChipStyle}" Content="📘 Facebook (0)" Padding="6,2" Click="BtnFilterFacebook_Click"/>
                            </StackPanel>

                            <!-- Right Controls: Delete, Prev, Index, Next, Close -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Delete / Dismiss Button -->
                                <Button x:Name="BtnDeleteNotification" Style="{StaticResource ActionChipStyle}" Background="#2B1219" BorderBrush="#E11D48" Foreground="#FDA4AF"
                                        Content="🗑️ Xóa" ToolTip="Xóa vĩnh viễn thông báo này (không bao giờ lặp lại)" Margin="0,0,6,0" Padding="6,2" Click="BtnDeleteNotification_Click"/>
                                
                                <!-- Prev / Next Page -->
                                <Button x:Name="BtnPrevNotif" Style="{StaticResource CircleIconBtn}" Width="20" Height="20" ToolTip="Thông báo trước" Click="BtnPrevNotif_Click">
                                    <TextBlock Text="◀" FontSize="9"/>
                                </Button>
                                <TextBlock x:Name="TxtNotifCounter" Text="1/1" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" Margin="3,0"/>
                                <Button x:Name="BtnNextNotif" Style="{StaticResource CircleIconBtn}" Width="20" Height="20" ToolTip="Thông báo kế tiếp" Margin="0,0,6,0" Click="BtnNextNotif_Click">
                                    <TextBlock Text="▶" FontSize="9"/>
                                </Button>

                                <Button Style="{StaticResource CircleIconBtn}" Width="20" Height="20" ToolTip="Đóng" Click="BtnCloseToCompact_Click">
                                    <TextBlock Text="✕" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Message Content Preview Bubble (or Empty State) -->
                        <Grid Grid.Row="1" Margin="0,4">
                            <!-- Bubble with text -->
                            <Border x:Name="BorderMsgBubble" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" 
                                    CornerRadius="10" Padding="12,6">
                                <TextBlock x:Name="TxtNotifyContent" 
                                           Text="Alo bạn ơi! Tài liệu thiết kế dự án đã hoàn thiện rồi nhé, bạn xem qua rồi phản hồi mình sớm nha!" 
                                           Foreground="#E2E8F0" FontSize="12" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                            </Border>

                            <!-- Empty State Card -->
                            <Border x:Name="BorderEmptyState" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" 
                                    CornerRadius="10" Padding="12,6" Visibility="Collapsed">
                                <TextBlock Text="🎉 Không có thông báo nào trong mục này (Đã xóa/đọc hết)!" 
                                           Foreground="#64748B" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Quick Reply Bar: Suggestions Chips + Input Box + Send Button -->
                        <Grid x:Name="GridReplyBar" Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,8,0">
                                <Border Background="#0B0F17" BorderBrush="#334155" BorderThickness="1" CornerRadius="14" Padding="12,3">
                                    <Grid>
                                        <TextBlock x:Name="TxtReplyPlaceholder" Text="Nhập nội dung trả lời trực tiếp..." Foreground="#64748B" 
                                                   FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <TextBox x:Name="InputReply" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" 
                                                 FontSize="11.5" VerticalAlignment="Center"
                                                 TextChanged="InputReply_TextChanged"
                                                 KeyDown="InputReply_KeyDown"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource ActionChipStyle}" Content="👍 Ok" Padding="6,2" Margin="0,0,3,0" Click="ChipReply_Click"/>
                                <Button Style="{StaticResource ActionChipStyle}" Content="⏳ Đợi 5p" Padding="6,2" Margin="0,0,4,0" Click="ChipReply_Click"/>
                                <Button x:Name="BtnSendReply" Style="{StaticResource ActionChipStyle}" 
                                        Background="#0284C7" BorderBrush="#38BDF8" Foreground="#FFFFFF" FontWeight="Bold"
                                        Content="➤ Gửi" Padding="10,3" Click="BtnSendReply_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- 7. DROPZONE TASK: NOTEBOOKLM INTEGRATION (Size: 660x155) -->
                    <Grid x:Name="ViewDropzone" Visibility="Collapsed" Margin="16,8"
                          AllowDrop="True" Drop="Dropzone_Drop" DragOver="Dropzone_DragOver">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header: NotebookLM Status & Config with Drag Handle & Refresh -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Border Tag="DragGrip" Background="#1E293B" CornerRadius="5" Padding="5,2" Margin="0,0,8,0"
                                        Cursor="SizeAll" ToolTip="Giữ chuột vào đây để kéo di chuyển Dynamic Island (Click đúp để về giữa)"
                                        PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="DragHandle_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="DragHandle_PreviewMouseLeftButtonUp"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="::" FontSize="13" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="📁" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNotebookHeaderTitle" Text="NotebookLM" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border x:Name="BorderNotebookStatus" Background="#291219" BorderBrush="#E11D48" BorderThickness="0.8" CornerRadius="8" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Cursor="Hand" ToolTip="Nhấp vào đây để mở bảng dán / đổi liên kết Sổ tay NotebookLM"
                                        MouseLeftButtonDown="BorderNotebookStatus_Click">
                                    <TextBlock x:Name="TxtNotebookStatus" Text="🔴 Chưa xác thực Sổ tay (Bấm để cài)" Foreground="#FDA4AF" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>

                            <!-- Hidden backing input box for backward compatibility -->
                            <TextBox x:Name="InputNotebookUrl" Visibility="Collapsed" TextChanged="InputNotebookUrl_TextChanged"/>

                            <!-- Quick Paste / Configure & Refresh & Close -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnQuickPasteNotebook" Style="{StaticResource ActionChipStyle}" 
                                        Background="#0F2B3E" BorderBrush="#38BDF8" Foreground="#38BDF8"
                                        Content="🔗 Dán / Đổi Link Sổ tay" ToolTip="Dán trực tiếp link NotebookLM từ Clipboard hoặc mở bảng cài đặt Sổ tay" 
                                        Margin="0,0,6,0" Padding="8,3" Click="BtnQuickPasteNotebook_Click"/>

                                <Button x:Name="BtnRefreshNotebook" Style="{StaticResource CircleIconBtn}" Width="24" Height="24"
                                        ToolTip="Làm mới kết nối &amp; Quét lại tên Sổ tay NotebookLM từ trình duyệt" Margin="0,0,5,0"
                                        Click="BtnRefreshNotebook_Click">
                                    <TextBlock x:Name="TxtRefreshSpin" Text="🔄" FontSize="11" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform x:Name="RefreshSpinRotate" Angle="0"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Button>

                                <Button Style="{StaticResource CircleIconBtn}" VerticalAlignment="Center" Click="BtnCloseToCompact_Click">
                                    <TextBlock Text="✕" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Staged Source Display Box (Files OR Web Links) -->
                        <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#062E24" BorderThickness="1" BorderBrush="#10B981" Margin="0,0,10,0">
                                    <TextBlock x:Name="TxtFileIcon" Text="📄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtFileName" Text="Kéo thả tệp hoặc bấm 'Dán Link Web / YouTube' (để nạp nguồn)" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtFileMeta" Text="Chưa có nguồn nào • Thả tệp hoặc dán link tài liệu để nạp vào Sổ tay" Foreground="#94A3B8" FontSize="10.5" Margin="0,1,0,0"/>
                                </StackPanel>

                                <Button x:Name="BtnClearFiles" Grid.Column="2" Style="{StaticResource CircleIconBtn}" Width="20" Height="20" ToolTip="Xóa nguồn đã chọn" Visibility="Collapsed" Click="BtnClearFiles_Click">
                                    <TextBlock Text="✕" FontSize="10" Foreground="#EF4444"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Action Buttons: Send to NotebookLM, Browse, Paste Link -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ActionChipStyle}" Content="📎 Chọn Tệp từ máy" Margin="0,0,6,0" Click="BtnBrowseFile_Click"/>
                            <Button x:Name="BtnPasteSourceLink" Style="{StaticResource ActionChipStyle}" Content="🌐 Dán Link Web / YouTube" ToolTip="Dán đường dẫn YouTube, Trang web hoặc Docs online để làm nguồn nạp vào NotebookLM" Margin="0,0,6,0" Click="BtnPasteSourceLink_Click"/>
                            <Button Style="{StaticResource ActionChipStyle}" Content="⚙️ Cài đặt Sổ tay" Margin="0,0,6,0" Click="BtnOpenNotebookConfig_Click"/>
                            <Button Style="{StaticResource ActionChipStyle}" Content="📂 Thư mục Downloads" Margin="0,0,6,0" Click="BtnOpenDownloads_Click"/>
                            <Button x:Name="BtnSendToNotebookLM" Style="{StaticResource ActionChipStyle}"
                                    Background="#0284C7" BorderBrush="#38BDF8" Foreground="#FFFFFF" FontWeight="Bold"
                                    Content="⚡ Thêm thẳng vào Notebook" ToolTip="Đưa trực tiếp tệp/link vào Sổ tay NotebookLM đang mở mà không mở thêm tab mới" Click="BtnSendToNotebookLM_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 8. LOCK SCREEN TASK (Size: 520x95) -->
                    <Grid x:Name="ViewLockScreen" Visibility="Collapsed" Margin="16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Drag Grip Handle & Lock Icon -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Border Tag="DragGrip" Background="#1E293B" CornerRadius="5" Padding="5,2" Margin="0,0,10,0"
                                    Cursor="SizeAll" ToolTip="Giữ chuột vào đây để kéo di chuyển Dynamic Island (Click đúp để về giữa)"
                                    PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="DragHandle_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="DragHandle_PreviewMouseLeftButtonUp"
                                    VerticalAlignment="Center">
                                <TextBlock Text="::" FontSize="13" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>

                            <Border Width="44" Height="44" CornerRadius="22" Background="#4C0A1C" BorderThickness="1.5" BorderBrush="#FB7185">
                                <Border.Effect>
                                    <DropShadowEffect Color="#F43F5E" BlurRadius="16" ShadowDepth="0" Opacity="0.8"/>
                                </Border.Effect>
                                <TextBlock Text="🔒" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Khóa màn hình máy tính (Lock Screen)" Foreground="#F8FAFC" FontSize="13.5" FontWeight="Bold"/>
                            <TextBlock Text="Đưa máy tính về màn hình khóa Windows bảo vệ quyền riêng tư ngay lập tức" Foreground="#FB7185" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource DangerButtonStyle}" Content="🔒 Khóa máy ngay" VerticalAlignment="Center" Margin="0,0,10,0" Click="BtnLockWorkstation_Click"/>
                        <Button Grid.Column="3" Style="{StaticResource CircleIconBtn}" VerticalAlignment="Center" Click="BtnCloseToCompact_Click">
                            <TextBlock Text="✕" FontSize="12"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- MODERN HUD FLOATING TOAST POPUP (Glassmorphism Notification) -->
        <Border x:Name="ModernToastHost" 
                HorizontalAlignment="Center" VerticalAlignment="Top" 
                Margin="0,52,0,0" 
                CornerRadius="16" 
                Background="#1E1B2ECC" 
                BorderThickness="1.2" 
                BorderBrush="#10B981" 
                Padding="16,8" 
                Visibility="Collapsed" 
                Opacity="0"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect x:Name="ToastGlow" Color="#10B981" BlurRadius="22" ShadowDepth="0" Opacity="0.9"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTranslate" Y="-15"/>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtToastIcon" Text="✨" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtToastMessage" Text="Thông báo hệ thống" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- MODERN NOTEBOOKLM SETTINGS POPUP MODAL -->
        <Border x:Name="PopupNotebookConfig" 
                HorizontalAlignment="Center" VerticalAlignment="Top" 
                Margin="0,48,0,0" 
                Width="560" 
                CornerRadius="20" 
                Background="#121626" 
                BorderThickness="1.5" 
                BorderBrush="#38BDF8" 
                Padding="22,18" 
                Visibility="Collapsed" 
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect x:Name="PopupNotebookGlow" Color="#0284C7" BlurRadius="32" ShadowDepth="0" Opacity="0.85"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="PopupNotebookTranslate" Y="-20"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Background="#0C2540" BorderThickness="1" BorderBrush="#38BDF8" Margin="0,0,10,0">
                            <TextBlock Text="🪐" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Cài đặt Liên kết Sổ tay NotebookLM" Foreground="#F8FAFC" FontSize="14.5" FontWeight="Bold"/>
                            <TextBlock Text="Tự động lưu làm Sổ tay mặc định để thêm nguồn nhanh" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource CircleIconBtn}" Width="26" Height="26" ToolTip="Đóng" Click="BtnCloseNotebookPopup_Click">
                        <TextBlock Text="✕" FontSize="12"/>
                    </Button>
                </Grid>

                <!-- Description / Instructions -->
                <TextBlock Grid.Row="1" Text="Dán đường dẫn sổ tay của bạn từ trình duyệt (dạng https://notebooklm.google.com/notebook/[id]). Dynamic Island sẽ tự động lưu và kết nối trực tiếp đến Sổ tay này."
                           Foreground="#CBD5E1" FontSize="11.5" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,12"/>

                <!-- Input Box with Clipboard Paste Button -->
                <Border Grid.Row="2" Background="#070B14" BorderBrush="#334155" BorderThickness="1.2" CornerRadius="12" Padding="12,6" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtPopupUrlPlaceholder" Text="https://notebooklm.google.com/notebook/..." Foreground="#64748B" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="InputPopupNotebookUrl" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" FontSize="12" VerticalAlignment="Center"
                                     TextChanged="InputPopupNotebookUrl_TextChanged" KeyDown="InputPopupNotebookUrl_KeyDown"/>
                        </Grid>

                        <Button x:Name="BtnPasteFromClipboard" Grid.Column="1" Style="{StaticResource ActionChipStyle}" 
                                Content="📋 Dán từ Clipboard" Padding="8,4" FontSize="11" Click="BtnPasteFromClipboard_Click"/>
                    </Grid>
                </Border>

                <!-- Status Feedback & Action Buttons -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Realtime Validation Status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPopupValidationStatus" Text="💡 Hãy dán liên kết Sổ tay NotebookLM của bạn vào ô trên" 
                                   Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ActionChipStyle}" Content="Hủy" Margin="0,0,8,0" Padding="12,5" Click="BtnCloseNotebookPopup_Click"/>
                        <Button x:Name="BtnSavePopupNotebook" Style="{StaticResource ActionChipStyle}" 
                                Background="#0284C7" BorderBrush="#38BDF8" Foreground="#FFFFFF" FontWeight="Bold"
                                Content="💾 Lưu &amp; Kết nối" Padding="14,5" Click="BtnSavePopupNotebook_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
